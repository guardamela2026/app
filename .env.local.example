# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la app (a la que apunta el QR). En dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (captcha anti-bots en login/registro por email).
# Site Key del widget: Cloudflare Dashboard -> Turnstile -> Add site.
# La Secret Key NO va acá: se carga en Supabase (Auth -> Attack Protection ->
# CAPTCHA -> Turnstile). Sin esta variable, el captcha queda desactivado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clave service_role de Supabase (Project Settings -> API -> service_role).
# SÓLO servidor: habilita eliminar la cuenta (borra el usuario de auth).
# NUNCA la expongas en el cliente ni la commitees. Sin ella, /api/eliminar-cuenta
# responde 500 y el resto de la app funciona igual.
SUPABASE_SERVICE_ROLE_KEY=
